  "item": [
    {
      "name": "Get Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Yanıt JSON formatında olmalı\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "const response = pm.response.json();",
              "const product = response.data.find(function (item) {",
              "    return item.product_image && item.product_image.file_name === \"pliers01.avif\";",
              "});",
              "pm.test(\"POM ürünü API listesinde bulunmalı\", function () {",
              "    pm.expect(product, \"POM ürünü API listesinde bulunamadı\").to.exist;",
              "});",
              "if (product) {",
              "    pm.collectionVariables.set(\"product_id\", product.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.practicesoftwaretesting.com/products",
          "protocol": "https",
          "host": [
            "api",
            "practicesoftwaretesting",
            "com"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
