    {
      "name": "Search Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Arama isteği 200 OK dönmeli\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Arama yanıtı geçerli JSON olmalı\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Arama sonucu ürün listesi içermeli\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.data).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Bulunan ürünler pliers aramasıyla eşleşmeli\", function () {\r\n    const response = pm.response.json();\r\n\r\n    response.data.forEach(function (product) {\r\n        const searchableText =\r\n            (product.name + \" \" + product.description).toLowerCase();\r\n\r\n        pm.expect(searchableText).to.include(\"pliers\");\r\n    });\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.practicesoftwaretesting.com/products/search?q=pliers",
          "protocol": "https",
          "host": [
            "api",
            "practicesoftwaretesting",
            "com"
          ],
          "path": [
            "products",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "pliers"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Product Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ürün detay isteği 200 OK dönmeli\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Ürün detay yanıtı geçerli JSON olmalı\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Yanıttaki ürün kimliği istenen ürünle eşleşmeli\", function () {",
              "    const product = pm.response.json();",
              "    pm.expect(product.id).to.eql(pm.collectionVariables.get(\"product_id\"));",
              "});",
              "pm.test(\"Ürün adı boş olmamalı\", function () {",
              "    const product = pm.response.json();",
              "    pm.expect(product.name).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
